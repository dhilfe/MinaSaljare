# Postgres (docker-compose)
POSTGRES_DB=minasaljare
POSTGRES_USER=minasaljare
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

# Gunicorn
WEB_CONCURRENCY=2
WEB_THREADS=2
WEB_TIMEOUT=60

# Optional (only if you run `docker compose --profile edge up`)
CF_TUNNEL_TOKEN=

# Optional (only if you run `docker compose --profile ops up`)
# Used by the backup service to encrypt pg_dump output.
BACKUP_PASSPHRASE=

# Used by the monitor service (healthchecks.io ping URL). Configure alerts in healthchecks.io.
HEALTHCHECKS_PING_URL=

# Override the URL monitor checks. Default is http://nginx/api/health/
MONITOR_URL=
