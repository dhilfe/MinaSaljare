# Postgres (docker-compose)
POSTGRES_DB=minasaljare
POSTGRES_USER=minasaljare
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

# Gunicorn
WEB_CONCURRENCY=2
WEB_THREADS=2
WEB_TIMEOUT=60

# Optional (only if you run `docker compose --profile edge up`)
CF_TUNNEL_TOKEN=
